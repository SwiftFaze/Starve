# Commands the Clean Code gate (.claude/tools/check-clean.sh) runs.
# Sourced by bash; environment variables of the same name override these.
# Keep VERIFY_CMD identical to the "Verify command" row in .claude/workflow.md.
#
# Examples:
#   Maven:    VERIFY_CMD="mvn -B verify"          LINT_CMD="mvn -B -q spotless:check"
#   Gradle:   VERIFY_CMD="./gradlew check"        LINT_CMD=""
#   Angular:  VERIFY_CMD="npm ci && npm test -- --watch=false && npm run build"
#             LINT_CMD="npx ng lint"
#   Node:     VERIFY_CMD="npm run verify"         LINT_CMD="npm run lint"
#   Python:   VERIFY_CMD="pytest --cov --cov-fail-under=85"  LINT_CMD="ruff check ."

VERIFY_CMD="./mvnw -B verify"
LINT_CMD="./mvnw -B -q com.github.gantsign.maven:ktlint-maven-plugin:check"
CLEAN_BASE_REF="develop"
