# Build output (add your stack's: /target/, /build/, /dist/, node_modules/, __pycache__/ ...)
/target/

# IDE / OS
/.idea/
/.vscode/
/.clj-kondo/
/.lsp/
*.iml
.DS_Store
Thumbs.db

# Claude Code: per-user settings and devflow's parallel-work worktrees
/.claude/settings.local.json
/.claude/worktrees/

# Intent docs are local scratch (see specs/intent/README.md) — never committed except the two
# files the pipeline itself depends on.
/specs/intent/*
!/specs/intent/README.md
!/specs/intent/TEMPLATE.md

# Local SQLite data
/data/

# impeccable skill: platform binary is installed per machine, not versioned (19 MB, Windows-only)
/.claude/skills/impeccable/scripts/bin/

# Akira Expanded (personal-use licence) is no longer used; this keeps any leftover local copy out of this public repo
/src/main/resources/static/fonts/akira-expanded*

# impeccable design tooling: throwaway decision sketches, review captures and per-machine settings
/.impeccable/mocks/
/.impeccable/review/
/.impeccable/config.local.json
/.impeccable/questions/
/.impeccable/hook.cache.json
